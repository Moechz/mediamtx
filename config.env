# ============================================================
# MediaMTX TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh all 即可
# ============================================================

# 上游版本（GitHub tag，不带 v 前缀）
# 主仓库: https://github.com/bluenviron/mediamtx
MEDIAMTX_VERSION=1.21.1

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 1.21.1-1
# 三处必须一致：config.ini / DEBIAN/control / mediamtx.lang；
# 每次提交商店严格递增；Release tag = v<完整版本>（如 v1.21.1-1）
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=1

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
# 可被环境变量覆盖（make arm64 即用）
TARGET_ARCH=${TARGET_ARCH:-amd64}

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
APP_ID=mediamtx

# 运行用户（规范要求专用非 root 用户；config.ini.user 与 systemd User 必须一致）
APP_USER=mediamtx

# 数据目录（配置、录制文件；remove 保留 / purge 删除）
DATA_DIR=/var/lib/mediamtx

# ---------------- 监听端口（官方推荐段 8000-19999；避开系统保留端口） ----------------
# 媒体端口对外（摄像头/编码器推流、播放器拉流）——这是应用的核心功能，必须放行
RTSP_PORT=8554          # 标准 RTSP 端口
RTMP_PORT=1935          # 标准 RTMP 端口
HLS_PORT=8888           # HLS（纯 HTTP，可经 TOS 网关 /mediamtx/hls/ 观看）
WEBRTC_PORT=8889        # WebRTC HTTP/WHIP/WHEP
WEBRTC_UDP_PORT=8189    # WebRTC ICE（UDP；也在推荐段内）
SRT_PORT=8890           # SRT
# 管理与辅助端口仅回环，绝不对外；经 TOS 网关路由访问
API_PORT=9997           # 管理 API（/mediamtx/api/）
METRICS_PORT=9998       # Prometheus 指标（仅回环）
PLAYBACK_PORT=9996      # 回放服务（默认关闭）

# ---------------- 自建二进制（V6 审核链路）----------------
# 本仓库 .github/workflows/build-upstream.yml 从上游 tag 源码
# bit-reproducible 构建（CGO_ENABLED=0 静态、无 UPX、两次构建字节一致），
# 产物发布于 Release build-v<上游版本>；此处 pin 自建 tarball 的 sha256。
# CI 重新构建后必须同步更新（build.sh fetch 会双层校验）。
SHA256_TARBALL_AMD64=fcdfa5c47b2425d39286336fcce6ab5409c67f7a91cf022018017d8817c93f40
SHA256_TARBALL_ARM64=e6610a15e0efeb30bb8ba8bb076a1b9658edf351b6c3dfd99e97d53f00be01b1

# 上游源码 tag 归档 sha256（可复现配方的“锁源码”一环，任何人可下载复核）
# 取自 https://github.com/bluenviron/mediamtx/archive/048255986f7e04b859b4c4efe651448ec785ecd4.tar.gz
# （= tag v1.21.1 的 commit；GitHub 生成的归档字节可能随时间变化，此为构建时快照）
SHA256_UPSTREAM_TAG_ARCHIVE=715c96397d0062832135d8ff3671f8817507301676fb9d42dda435fd669fbee7

# 构建工具链 pin（可复现配方的一部分；CI 与审核者用同一版本）
GO_TOOLCHAIN_VERSION=1.26.8

# deb 维护者信息（DEBIAN/control 的 Maintainer）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"

# 应用中心展示的「发布者」（坑 49：publisher=打包者；作者语义字段 auth 归上游）
PUBLISHER="Moechz"
# 上游作者（lang 的 auth 字段）
UPSTREAM_AUTHOR="bluenviron"
