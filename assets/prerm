#!/bin/bash
# prerm - 删除/升级前处理（官方模板：清杀应用用户全部残留进程 + 停用服务）
set -e

APP_USER=mediamtx
MAINT_LOG=/var/log/mediamtx-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') prerm $*" >> "$MAINT_LOG" 2>/dev/null || true

# 清杀应用用户残留进程（升级安全）
pkill -u "$APP_USER" 2>/dev/null || true
sleep 1

# 停止服务；升级路径只停不 disable（重新启用交给新版 postinst；坑 3）
systemctl stop mediamtx.service 2>/dev/null || true
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
  systemctl disable mediamtx.service 2>/dev/null || true
fi

exit 0
