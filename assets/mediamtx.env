# ============================================================
# MediaMTX 环境变量（由 postinst 首装从 mediamtx.env.example 复制而来）
# 修改后执行: systemctl restart mediamtx
#
# 注意：MediaMTX 的绝大多数配置项在 /var/lib/mediamtx/mediamtx.yml 中，
# 本文件只用于 systemd 环境级变量与 MediaMTX 支持的环境变量。
# ============================================================

# Go 运行时内存软上限（0 = 不限制）。媒体中转内存占用与并发路数相关，
# 小内存机型可设为例如 512MiB。
#GOMEMLIMIT=0

# Go 垃圾回收目标百分比（默认 100）
#GOGC=100

# 时区（日志时间戳）
#TZ=Asia/Shanghai

# MediaMTX 凭据加密密钥：设置后，mediamtx.yml 中的密码可写成加密串，
# 避免明文落盘（生成: openssl rand -hex 32）。
# 完整说明: https://github.com/bluenviron/mediamtx#encrypting-credentials
#MTX_CONFKEY=
