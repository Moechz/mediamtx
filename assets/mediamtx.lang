[en-us]
name         = "MediaMTX Streaming Server"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX is a self-hosted media streaming server built around a single dependency-free Go binary. It speaks RTSP, RTMP, HLS, WebRTC and SRT at the same time: cameras and encoders publish a stream once, and any number of players pull it over the protocol of their choice — the natural relay and base for IP-camera monitoring and live broadcasting on a NAS. A built-in web console opens in a new browser tab from the TOS desktop: it lists active paths, links to the browser player and proxies the complete management API. The management API (9997), metrics (9998) and playback (9996) listeners are bound to loopback only and are reachable exclusively through the TOS web-server gateway. Media ports stay open for LAN clients because they are the core function: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) and SRT 8890. The service runs as a dedicated unprivileged user inside a hardened systemd sandbox."
release_note = "Built from the official MediaMTX 1.21.1 source code with a public, bit-reproducible CI recipe (static Go build, no bundled runtime) and no online installation at any point. Configuration lives in /var/lib/mediamtx/mediamtx.yml and is hot-reloaded after edits. A random publisher password is generated at install time and stored root-readable in /var/lib/mediamtx/publisher_password.txt; viewing is anonymous by default. Media ports: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. The management API, metrics and playback listeners bind to loopback and are used through the TOS route /mediamtx/."
important    = "Publishing requires the username 'publisher' and the random password stored in /var/lib/mediamtx/publisher_password.txt (readable by the NAS administrator); viewing is anonymous unless you change it. Edit /var/lib/mediamtx/mediamtx.yml to add authentication, recording, per-path settings or more users — changes are hot-reloaded. 'apt remove' keeps /var/lib/mediamtx; 'apt purge' deletes configuration, recordings and the password file. Licensed MIT upstream."

[zh-cn]
name         = "MediaMTX 流媒体服务器"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX 是一款自托管的流媒体服务器，由单个零外部依赖的 Go 二进制构成，同时支持 RTSP、RTMP、HLS、WebRTC 与 SRT：摄像头/编码器只需推流一次，任意数量的播放端都能用自己熟悉的协议拉流，是 NAS 上做监控汇聚与直播中转的理想底座。应用从 TOS 桌面以新标签页打开内置网页控制台，可查看活动路径、跳转浏览器播放页，并转发完整的管理 API。管理 API（9997）、指标（9998）与回放（9996）只监听本机回环，仅能经 TOS 网页服务网关访问；媒体端口按功能对局域网开放：RTSP 8554、RTMP 1935、HLS 8888、WebRTC 8889（ICE/UDP 8189）、SRT 8890。服务以专用非特权用户运行，并施加 systemd 沙箱加固。"
release_note = "基于上游 MediaMTX 1.21.1 官方源码构建，采用公开、可复现（bit-reproducible）的 CI 配方（Go 静态编译、不捆绑任何运行时），全流程无在线安装。配置位于 /var/lib/mediamtx/mediamtx.yml，修改后自动热加载。安装时随机生成推流密码并存放于 /var/lib/mediamtx/publisher_password.txt（NAS 管理员可读），观看默认匿名。媒体端口：RTSP 8554、RTMP 1935、HLS 8888、WebRTC 8889（ICE/UDP 8189）、SRT 8890。管理 API、指标与回放仅监听回环，经 TOS 路由 /mediamtx/ 访问。"
important    = "推流需使用用户名 publisher 与 /var/lib/mediamtx/publisher_password.txt 中的随机密码（NAS 管理员可读）；观看默认匿名，可在配置中改为需鉴权。编辑 /var/lib/mediamtx/mediamtx.yml 可添加鉴权、录制、路径级参数或更多用户，改动会自动热加载。apt remove 保留 /var/lib/mediamtx；apt purge 会删除配置、录制与密码文件。上游采用 MIT 许可证。"

[zh-hk]
name         = "MediaMTX 串流伺服器"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX 是一款自架設的串流伺服器，由單一零外部相依的 Go 執行檔構成，同時支援 RTSP、RTMP、HLS、WebRTC 與 SRT：攝影機/編碼器只需推流一次，任意數量的播放端都能用自己熟悉的協定拉流，是 NAS 上做監控匯聚與直播轉送的理想底座。應用從 TOS 桌面以新分頁開啟內建網頁主控台，可檢視活動路徑、跳轉瀏覽器播放頁，並轉發完整的管理 API。管理 API（9997）、指標（9998）與回放（9996）只監聽本機回環，僅能經 TOS 網頁服務閘道存取；媒體連接埠依功能對區域網路開放：RTSP 8554、RTMP 1935、HLS 8888、WebRTC 8889（ICE/UDP 8189）、SRT 8890。服務以專用非特權使用者執行，並施加 systemd 沙箱強化。"
release_note = "基於上游 MediaMTX 1.21.1 官方原始碼構建，採用公開、可複現（bit-reproducible）的 CI 配方（Go 靜態編譯、不綁定任何執行環境），全流程無線上安裝。設定位於 /var/lib/mediamtx/mediamtx.yml，修改後自動熱載入。安裝時隨機產生推流密碼並存放於 /var/lib/mediamtx/publisher_password.txt（NAS 管理員可讀），觀看預設匿名。媒體連接埠：RTSP 8554、RTMP 1935、HLS 8888、WebRTC 8889（ICE/UDP 8189）、SRT 8890。管理 API、指標與回放僅監聽回環，經 TOS 路由 /mediamtx/ 存取。"
important    = "推流需使用使用者名稱 publisher 與 /var/lib/mediamtx/publisher_password.txt 中的隨機密碼（NAS 管理員可讀）；觀看預設匿名，可在設定中改為需驗證。編輯 /var/lib/mediamtx/mediamtx.yml 可新增驗證、錄影、路徑級參數或更多使用者，變更會自動熱載入。apt remove 保留 /var/lib/mediamtx；apt purge 會刪除設定、錄影與密碼檔案。上游採用 MIT 授權條款。"

[fr-fr]
name         = "Serveur de streaming MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX est un serveur de diffusion multimédia auto-hébergé, constitué d'un unique binaire Go sans dépendances. Il parle simultanément RTSP, RTMP, HLS, WebRTC et SRT : les caméras et les encodeurs publient un flux une seule fois, et un nombre illimité de lecteurs le récupèrent avec le protocole de leur choix — la base idéale pour la surveillance par caméras IP et la diffusion en direct sur un NAS. Une console web intégrée s'ouvre dans un nouvel onglet depuis le bureau TOS : elle liste les flux actifs, renvoie vers le lecteur du navigateur et relaie l'API de gestion complète. L'API de gestion (9997), les métriques (9998) et la lecture différée (9996) n'écoutent que sur loopback et ne sont accessibles que via la passerelle web de TOS. Les ports média restent ouverts au réseau local car ils constituent la fonction principale : RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) et SRT 8890. Le service s'exécute sous un utilisateur dédié non privilégié dans un bac à sable systemd renforcé."
release_note = "Compilé depuis le code source officiel de MediaMTX 1.21.1 selon une recette CI publique et reproductible au bit près (build Go statique, aucune dépendance d'exécution) et sans aucune installation en ligne. La configuration réside dans /var/lib/mediamtx/mediamtx.yml et est rechargée à chaud. Un mot de passe de publication aléatoire est généré à l'installation et conservé en lecture root dans /var/lib/mediamtx/publisher_password.txt ; la lecture est anonyme par défaut. Ports média : RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. L'API, les métriques et la lecture différée écoutent sur loopback et passent par la route TOS /mediamtx/."
important    = "La publication nécessite l'identifiant « publisher » et le mot de passe aléatoire stocké dans /var/lib/mediamtx/publisher_password.txt (lisible par l'administrateur du NAS) ; la lecture est anonyme par défaut. Modifiez /var/lib/mediamtx/mediamtx.yml pour ajouter l'authentification, l'enregistrement, des réglages par flux ou d'autres utilisateurs : les changements sont rechargés à chaud. « apt remove » conserve /var/lib/mediamtx ; « apt purge » supprime configuration, enregistrements et fichier de mot de passe. Licence MIT en amont."

[de-de]
name         = "MediaMTX Streaming-Server"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX ist ein selbst gehosteter Media-Streaming-Server auf Basis eines einzigen abhängigkeitsfreien Go-Binärprogramms. Er beherrscht RTSP, RTMP, HLS, WebRTC und SRT gleichzeitig: Kameras und Encoder veröffentlichen einen Stream einmal, und beliebig viele Abspielgeräte holen ihn über das Protokoll ihrer Wahl — die ideale Basis für IP-Kamera-Überwachung und Live-Übertragung auf einem NAS. Eine integrierte Web-Konsole öffnet sich in einem neuen Browser-Tab vom TOS-Desktop: Sie listet aktive Pfade, verlinkt den Browser-Player und leitet die vollständige Verwaltungs-API weiter. Verwaltungs-API (9997), Metriken (9998) und Wiedergabe (9996) lauschen nur auf Loopback und sind ausschließlich über das TOS-Web-Gateway erreichbar. Die Medienports bleiben für LAN-Clients offen, da sie die Kernfunktion sind: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) und SRT 8890. Der Dienst läuft als dedizierter unprivilegierter Benutzer in einer gehärteten systemd-Sandbox."
release_note = "Gebaut aus dem offiziellen MediaMTX-1.21.1-Quellcode mit einem öffentlichen, bit-genau reproduzierbaren CI-Rezept (statischer Go-Build, keine mitgelieferte Laufzeit) und ohne jede Online-Installation. Die Konfiguration liegt in /var/lib/mediamtx/mediamtx.yml und wird nach Änderungen automatisch neu geladen. Ein zufälliges Publish-Passwort wird bei der Installation erzeugt und root-lesbar in /var/lib/mediamtx/publisher_password.txt gespeichert; das Ansehen ist standardmäßig anonym. Medienports: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. Verwaltungs-API, Metriken und Wiedergabe lauschen auf Loopback und laufen über die TOS-Route /mediamtx/."
important    = "Zum Veröffentlichen werden der Benutzername „publisher“ und das zufällige Passwort aus /var/lib/mediamtx/publisher_password.txt benötigt (lesbar für den NAS-Administrator); das Ansehen ist standardmäßig anonym. Bearbeiten Sie /var/lib/mediamtx/mediamtx.yml, um Authentifizierung, Aufzeichnung, pfadspezifische Einstellungen oder weitere Benutzer hinzuzufügen — Änderungen werden automatisch neu geladen. „apt remove“ behält /var/lib/mediamtx; „apt purge“ löscht Konfiguration, Aufzeichnungen und Passwortdatei. Upstream-Lizenz: MIT."

[it-it]
name         = "Server di streaming MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX è un server di streaming multimediale self-hosted basato su un unico binario Go senza dipendenze. Supporta contemporaneamente RTSP, RTMP, HLS, WebRTC e SRT: telecamere ed encoder pubblicano un flusso una sola volta e un numero illimitato di lettori lo prelevano con il protocollo che preferiscono — la base ideale per la videosorveglianza con telecamere IP e la diretta su un NAS. Una console web integrata si apre in una nuova scheda dal desktop TOS: elenca i flussi attivi, rimanda al player del browser e inoltra l'intera API di gestione. API di gestione (9997), metriche (9998) e riproduzione (9996) restano in ascolto solo su loopback e sono raggiungibili esclusivamente tramite il gateway web di TOS. Le porte media restano aperte alla rete locale perché sono la funzione principale: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) e SRT 8890. Il servizio gira come utente dedicato non privilegiato in una sandbox systemd rafforzata."
release_note = "Compilato dal codice sorgente ufficiale di MediaMTX 1.21.1 con una recipe CI pubblica e riproducibile bit per bit (build Go statica, nessun runtime incluso) e senza alcuna installazione online. La configurazione si trova in /var/lib/mediamtx/mediamtx.yml e viene ricaricata a caldo. All'installazione viene generata una password di pubblicazione casuale, salvata in chiaro leggibile da root in /var/lib/mediamtx/publisher_password.txt; la visione è anonima per impostazione predefinita. Porte media: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. API, metriche e riproduzione ascoltano su loopback e passano dalla rotta TOS /mediamtx/."
important    = "Per pubblicare servono l'utente «publisher» e la password casuale in /var/lib/mediamtx/publisher_password.txt (leggibile dall'amministratore del NAS); la visione è anonima per impostazione predefinita. Modifica /var/lib/mediamtx/mediamtx.yml per aggiungere autenticazione, registrazione, impostazioni per flusso o altri utenti: le modifiche vengono ricaricate a caldo. 'apt remove' conserva /var/lib/mediamtx; 'apt purge' elimina configurazione, registrazioni e file della password. Licenza upstream MIT."

[es-es]
name         = "Servidor de streaming MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX es un servidor de streaming multimedia autoalojado basado en un único binario Go sin dependencias. Habla RTSP, RTMP, HLS, WebRTC y SRT a la vez: las cámaras y los codificadores publican un flujo una sola vez y cualquier número de reproductores lo toman con el protocolo que prefieran — la base ideal para la videovigilancia con cámaras IP y la emisión en directo en un NAS. Una consola web integrada se abre en una pestaña nueva desde el escritorio TOS: lista los flujos activos, enlaza al reproductor del navegador y reenvía la API de gestión completa. La API de gestión (9997), las métricas (9998) y la reproducción (9996) escuchan solo en loopback y son accesibles únicamente a través de la pasarela web de TOS. Los puertos de medios permanecen abiertos a la red local porque son la función principal: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) y SRT 8890. El servicio se ejecuta como un usuario dedicado sin privilegios en un sandbox systemd reforzado."
release_note = "Compilado desde el código fuente oficial de MediaMTX 1.21.1 con una receta de CI pública y reproducible bit a bit (compilación Go estática, sin runtime incluido) y sin instalación en línea en ningún momento. La configuración está en /var/lib/mediamtx/mediamtx.yml y se recarga en caliente. En la instalación se genera una contraseña de publicación aleatoria que se guarda legible por root en /var/lib/mediamtx/publisher_password.txt; la visualización es anónima por defecto. Puertos de medios: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. La API, las métricas y la reproducción escuchan en loopback y se usan a través de la ruta TOS /mediamtx/."
important    = "Para publicar se requieren el usuario «publisher» y la contraseña aleatoria de /var/lib/mediamtx/publisher_password.txt (legible por el administrador del NAS); la visualización es anónima por defecto. Edita /var/lib/mediamtx/mediamtx.yml para añadir autenticación, grabación, ajustes por flujo o más usuarios: los cambios se recargan en caliente. 'apt remove' conserva /var/lib/mediamtx; 'apt purge' elimina configuración, grabaciones y archivo de contraseña. Licencia MIT upstream."

[hu-hu]
name         = "MediaMTX streaming kiszolgáló"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "A MediaMTX egy önállóan üzemeltetett médiastreaming-kiszolgáló, amely egyetlen, külső függőség nélküli Go binárisból áll. Egyszerre beszéli az RTSP, RTMP, HLS, WebRTC és SRT protokollokat: a kamerák és kódolók egyszer publikálnak egy streamet, és bármennyi lejátszó a számára kedvező protokollal húzhatja le — ideális alap IP-kamerás megfigyeléshez és élő közvetítéshez NAS-on. A beépített webkonzol a TOS asztalról új böngészőlapon nyílik meg: listázza az aktív útvonalakat, a böngészős lejátszóra mutat, és továbbítja a teljes kezelői API-t. A kezelői API (9997), a metrikák (9998) és a visszajátszás (9996) csak loopbacken figyel, és kizárólag a TOS webes átjáróján érhető el. A médiaportok a helyi hálózat felé nyitottak, mert ez a fő funkció: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) és SRT 8890. A szolgáltatás dedikált, nem privilegizált felhasználóként fut, megerősített systemd sandboxban."
release_note = "A hivatalos MediaMTX 1.21.1 forráskódból építve, nyilvános és bitre reprodukálható CI-recepttel (statikus Go build, mellékelt futtatókörnyezet nélkül), online telepítés nélkül. A konfiguráció a /var/lib/mediamtx/mediamtx.yml fájlban van, és szerkesztés után automatikusan újratöltődik. Telepítéskor véletlen közzétételi jelszó generálódik, amely root által olvashatóan a /var/lib/mediamtx/publisher_password.txt fájlba kerül; a megtekintés alapértelmezésben névtelen. Médiaportok: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. A kezelői API, a metrikák és a visszajátszás loopbacken figyel, a TOS /mediamtx/ útvonalán keresztül használható."
important    = "A közzétételhez a „publisher” felhasználónév és a /var/lib/mediamtx/publisher_password.txt fájlban lévő véletlen jelszó kell (a NAS rendszergazdája olvashatja); a megtekintés alapértelmezésben névtelen. A /var/lib/mediamtx/mediamtx.yml szerkesztésével hitelesítést, felvételt, útvonalankénti beállításokat vagy további felhasználókat adhat hozzá — a módosítások automatikusan újratöltődnek. Az 'apt remove' megőrzi a /var/lib/mediamtx tartalmát; az 'apt purge' törli a konfigurációt, a felvételeket és a jelszófájlt. A felsőbb réteg licencje MIT."

[ja-jp]
name         = "MediaMTX ストリーミングサーバー"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX は、依存関係のない単一の Go バイナリで動く自己ホスト型メディアストリーミングサーバーです。RTSP・RTMP・HLS・WebRTC・SRT を同時に扱えるため、カメラやエンコーダーは一度配信するだけで、任意の数の再生側が好きなプロトコルで受信できます。NAS での IP カメラ監視やライブ配信の基盤に最適です。内蔵の Web コンソールは TOS デスクトップから新しいタブで開き、アクティブなパス一覧、ブラウザープレーヤーへのリンク、管理 API の転送を提供します。管理 API (9997)、メトリクス (9998)、再生 (9996) はループバックのみで待ち受け、TOS の Web ゲートウェイ経由でのみ到達できます。メディアポートは本来の機能のため LAN に開放します: RTSP 8554、RTMP 1935、HLS 8888、WebRTC 8889 (ICE/UDP 8189)、SRT 8890。サービスは専用の非特権ユーザーとして、強化された systemd サンドボックス内で動作します。"
release_note = "公式 MediaMTX 1.21.1 のソースコードから、公開されたビット単位で再現可能な CI レシピ（静的 Go ビルド、ランタイム同梱なし）で構築し、オンラインインストールは一切行いません。設定は /var/lib/mediamtx/mediamtx.yml にあり、編集後は自動でホットリロードされます。インストール時にランダムな配信パスワードを生成し、root のみ読める /var/lib/mediamtx/publisher_password.txt に保存します。視聴は既定で匿名です。メディアポート: RTSP 8554、RTMP 1935、HLS 8888、WebRTC 8889 (ICE/UDP 8189)、SRT 8890。管理 API・メトリクス・再生はループバックで待ち受け、TOS の /mediamtx/ ルート経由で利用します。"
important    = "配信にはユーザー名 publisher と /var/lib/mediamtx/publisher_password.txt のランダムなパスワード（NAS 管理者が読取可能）が必要です。視聴は既定で匿名ですが設定で変更できます。/var/lib/mediamtx/mediamtx.yml を編集して認証・録画・パス単位の設定・追加ユーザーを構成でき、変更は自動でホットリロードされます。'apt remove' は /var/lib/mediamtx を保持し、'apt purge' は設定・録画・パスワードファイルを削除します。上流ライセンスは MIT です。"

[ko-kr]
name         = "MediaMTX 스트리밍 서버"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX는 외부 의존성이 없는 단일 Go 바이너리로 동작하는 자체 호스팅 미디어 스트리밍 서버입니다. RTSP, RTMP, HLS, WebRTC, SRT를 동시에 지원하므로 카메라와 인코더가 한 번만 송출하면 원하는 프로토콜로 무제한의 재생 클라이언트가 수신할 수 있습니다. NAS에서 IP 카메라 모니터링과 라이브 방송을 위한 이상적인 기반입니다. 내장 웹 콘솔은 TOS 데스크톱에서 새 탭으로 열리며 활성 경로 목록, 브라우저 플레이어 링크, 전체 관리 API 프록시를 제공합니다. 관리 API(9997), 메트릭(9998), 재생(9996)은 루프백에서만 수신하며 TOS 웹 게이트웨이를 통해서만 접근할 수 있습니다. 미디어 포트는 핵심 기능이므로 LAN에 개방됩니다: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889(ICE/UDP 8189), SRT 8890. 서비스는 전용 비권한 사용자로 강화된 systemd 샌드박스에서 실행됩니다."
release_note = "공식 MediaMTX 1.21.1 소스 코드에서 공개적이고 비트 단위로 재현 가능한 CI 레시피(정적 Go 빌드, 런타임 미포함)로 빌드했으며 온라인 설치를 전혀 수행하지 않습니다. 설정은 /var/lib/mediamtx/mediamtx.yml 에 있고 편집 후 자동으로 핫 리로드됩니다. 설치 시 무작위 송출 비밀번호를 생성하여 root만 읽을 수 있는 /var/lib/mediamtx/publisher_password.txt 에 저장합니다. 시청은 기본적으로 익명입니다. 미디어 포트: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889(ICE/UDP 8189), SRT 8890. 관리 API, 메트릭, 재생은 루프백에서 수신하며 TOS /mediamtx/ 경로로 사용합니다."
important    = "송출에는 사용자 이름 publisher 와 /var/lib/mediamtx/publisher_password.txt 의 무작위 비밀번호(NAS 관리자가 읽을 수 있음)가 필요합니다. 시청은 기본적으로 익명이며 설정으로 변경할 수 있습니다. /var/lib/mediamtx/mediamtx.yml 을 편집하여 인증, 녹화, 경로별 설정, 추가 사용자를 구성할 수 있으며 변경 사항은 자동으로 핫 리로드됩니다. 'apt remove' 는 /var/lib/mediamtx 를 유지하고 'apt purge' 는 설정, 녹화, 비밀번호 파일을 삭제합니다. 업스트림 라이선스는 MIT 입니다."

[pl-pl]
name         = "Serwer strumieniowania MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX to samodzielnie hostowany serwer strumieniowania multimediów oparty na jednym binarium Go bez zależności. Obsługuje jednocześnie RTSP, RTMP, HLS, WebRTC i SRT: kamery i enkodery publikują strumień raz, a dowolna liczba odtwarzaczy pobiera go wybranym protokołem — idealna baza do monitoringu z kamer IP i transmisji na żywo na NAS. Wbudowana konsola web otwiera się w nowej karcie z pulpitu TOS: wyświetla aktywne ścieżki, linkuje odtwarzacz przeglądarki i przekazuje pełne API zarządzania. API zarządzania (9997), metryki (9998) i odtwarzanie (9996) nasłuchują wyłącznie na loopback i są dostępne tylko przez bramę web TOS. Porty mediów pozostają otwarte w sieci lokalnej, bo stanowią główną funkcję: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) i SRT 8890. Usługa działa jako dedykowany użytkownik bez uprawnień w wzmocnionej piaskownicy systemd."
release_note = "Zbudowany z oficjalnego kodu źródłowego MediaMTX 1.21.1 według publicznego, powtarzalnego co do bitu przepisu CI (statyczna kompilacja Go, bez dołączonego środowiska uruchomieniowego) bez żadnej instalacji online. Konfiguracja znajduje się w /var/lib/mediamtx/mediamtx.yml i jest przeładowywana na gorąco. Podczas instalacji generowane jest losowe hasło publikowania, zapisywane do odczytu przez root w /var/lib/mediamtx/publisher_password.txt; oglądanie jest domyślnie anonimowe. Porty mediów: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. API, metryki i odtwarzanie nasłuchują na loopback i są używane przez trasę TOS /mediamtx/."
important    = "Do publikowania potrzebna jest nazwa użytkownika „publisher” i losowe hasło z /var/lib/mediamtx/publisher_password.txt (do odczytu przez administratora NAS); oglądanie jest domyślnie anonimowe. Edytuj /var/lib/mediamtx/mediamtx.yml, aby dodać uwierzytelnianie, nagrywanie, ustawienia ścieżek lub kolejnych użytkowników — zmiany są przeładowywane na gorąco. 'apt remove' zachowuje /var/lib/mediamtx; 'apt purge' usuwa konfigurację, nagrania i plik hasła. Licencja upstream: MIT."

[ru-ru]
name         = "Сервер стриминга MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX — это самостоятельно размещаемый сервер потокового мультимедиа на основе одного бинарного файла Go без зависимостей. Он одновременно поддерживает RTSP, RTMP, HLS, WebRTC и SRT: камеры и кодировщики публикуют поток один раз, а любое число плееров получает его удобным протоколом — идеальная основа для видеонаблюдения с IP-камер и прямых трансляций на NAS. Встроенная веб-консоль открывается в новой вкладке с рабочего стола TOS: она показывает активные пути, ссылается на браузерный плеер и проксирует полный API управления. API управления (9997), метрики (9998) и воспроизведение (9996) слушают только loopback и доступны исключительно через веб-шлюз TOS. Медиапорты открыты для локальной сети, так как это основная функция: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) и SRT 8890. Служба работает от выделенного непривилегированного пользователя в усиленной песочнице systemd."
release_note = "Собран из официального исходного кода MediaMTX 1.21.1 по публичному, побитово воспроизводимому рецепту CI (статическая сборка Go, без встроенной среды выполнения) и без какой-либо онлайн-установки. Конфигурация находится в /var/lib/mediamtx/mediamtx.yml и перезагружается на лету. При установке генерируется случайный пароль публикации и сохраняется доступным только root в /var/lib/mediamtx/publisher_password.txt; просмотр по умолчанию анонимный. Медиапорты: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. API, метрики и воспроизведение слушают loopback и используются через маршрут TOS /mediamtx/."
important    = "Для публикации нужны имя пользователя «publisher» и случайный пароль из /var/lib/mediamtx/publisher_password.txt (доступен администратору NAS); просмотр по умолчанию анонимный. Редактируйте /var/lib/mediamtx/mediamtx.yml, чтобы добавить аутентификацию, запись, настройки путей или новых пользователей — изменения применяются на лету. 'apt remove' сохраняет /var/lib/mediamtx; 'apt purge' удаляет конфигурацию, записи и файл пароля. Лицензия upstream: MIT."

[tr-tr]
name         = "MediaMTX Yayın Sunucusu"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX, bağımlılığı olmayan tek bir Go ikili dosyası üzerine kurulu, kendi sunucunuzda barındırabileceğiniz bir medya akış sunucusudur. RTSP, RTMP, HLS, WebRTC ve SRT protokollerini aynı anda konuşur: kameralar ve kodlayıcılar bir akışı yalnızca bir kez yayınlar, sınırsız sayıda oynatıcı ise istediği protokolle akışı çeker — NAS üzerinde IP kamera izleme ve canlı yayın için ideal bir aktarım tabanıdır. Dahili web konsolu TOS masaüstünden yeni bir sekmede açılır: etkin yolları listeler, tarayıcı oynatıcısına bağlantı verir ve tüm yönetim API'sini aktarır. Yönetim API'si (9997), metrikler (9998) ve oynatma (9996) yalnızca loopback üzerinde dinler ve sadece TOS web ağ geçidi üzerinden erişilebilir. Medya portları yerel ağa açıktır çünkü asıl işlev bunlardır: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) ve SRT 8890. Hizmet, özel ayrıcalıksız bir kullanıcı olarak sertleştirilmiş systemd korumalı alanında çalışır."
release_note = "Resmî MediaMTX 1.21.1 kaynak kodundan, herkese açık ve bit düzeyinde yeniden üretilebilir bir CI tarifiyle (statik Go derlemesi, gömülü çalışma zamanı yok) derlenmiştir; hiçbir aşamada çevrimiçi kurulum yapılmaz. Yapılandırma /var/lib/mediamtx/mediamtx.yml içindedir ve düzenlendikten sonra otomatik olarak sıcak yeniden yüklenir. Kurulumda rastgele bir yayın parolası üretilir ve yalnızca root'un okuyabildiği /var/lib/mediamtx/publisher_password.txt içine kaydedilir; izleme varsayılan olarak anonimdir. Medya portları: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. Yönetim API'si, metrikler ve oynatma loopback üzerinde dinler ve TOS /mediamtx/ rotası üzerinden kullanılır."
important    = "Yayın yapmak için «publisher» kullanıcı adı ve /var/lib/mediamtx/publisher_password.txt içindeki rastgele parola gerekir (NAS yöneticisi okuyabilir); izleme varsayılan olarak anonimdir. Kimlik doğrulama, kayıt, yol bazlı ayarlar veya ek kullanıcılar eklemek için /var/lib/mediamtx/mediamtx.yml dosyasını düzenleyin — değişiklikler otomatik olarak sıcak yüklenir. 'apt remove' /var/lib/mediamtx dizinini korur; 'apt purge' yapılandırmayı, kayıtları ve parola dosyasını siler. Üst kaynak lisansı MIT'tir."

[pt-pt]
name         = "Servidor de streaming MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "O MediaMTX é um servidor de streaming de multimédia auto-hospedado baseado num único binário Go sem dependências. Fala RTSP, RTMP, HLS, WebRTC e SRT em simultâneo: câmaras e codificadores publicam um fluxo uma só vez e qualquer número de leitores recolhe-o com o protocolo que preferir — a base ideal para videovigilância com câmaras IP e emissão em direto num NAS. Uma consola web integrada abre num novo separador a partir do ambiente de trabalho TOS: lista os fluxos ativos, liga ao leitor do navegador e reencaminha a API de gestão completa. A API de gestão (9997), as métricas (9998) e a reprodução (9996) escutam apenas em loopback e são acessíveis exclusivamente através da gateway web do TOS. As portas de média ficam abertas à rede local porque são a função principal: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) e SRT 8890. O serviço corre como utilizador dedicado sem privilégios numa sandbox systemd reforçada."
release_note = "Compilado a partir do código-fonte oficial do MediaMTX 1.21.1 com uma receita de CI pública e reproduzível bit a bit (compilação Go estática, sem runtime incluído) e sem qualquer instalação online. A configuração está em /var/lib/mediamtx/mediamtx.yml e é recarregada a quente. Na instalação é gerada uma palavra-passe de publicação aleatória, guardada em /var/lib/mediamtx/publisher_password.txt (legível pelo root); a visualização é anónima por omissão. Portas de média: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890. A API, as métricas e a reprodução escutam em loopback e são usadas pela rota TOS /mediamtx/."
important    = "Para publicar são necessários o utilizador «publisher» e a palavra-passe aleatória em /var/lib/mediamtx/publisher_password.txt (legível pelo administrador do NAS); a visualização é anónima por omissão. Edite /var/lib/mediamtx/mediamtx.yml para adicionar autenticação, gravação, definições por fluxo ou mais utilizadores — as alterações são recarregadas a quente. 'apt remove' mantém /var/lib/mediamtx; 'apt purge' apaga configuração, gravações e ficheiro da palavra-passe. Licença upstream: MIT."

[ar-sa]
name         = "MediaMTX Streaming Server"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX is a self-hosted media streaming server built around a single dependency-free Go binary. It speaks RTSP, RTMP, HLS, WebRTC and SRT at the same time: cameras and encoders publish a stream once, and any number of players pull it over the protocol of their choice. A built-in web console opens in a new browser tab from the TOS desktop and proxies the complete management API. The management API (9997), metrics (9998) and playback (9996) listeners are bound to loopback only and are reachable exclusively through the TOS web-server gateway. Media ports stay open for LAN clients because they are the core function: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) and SRT 8890. The service runs as a dedicated unprivileged user inside a hardened systemd sandbox."
release_note = "Built from the official MediaMTX 1.21.1 source code with a public, bit-reproducible CI recipe (static Go build, no bundled runtime) and no online installation at any point. Configuration lives in /var/lib/mediamtx/mediamtx.yml and is hot-reloaded. A random publisher password is generated at install time and stored root-readable in /var/lib/mediamtx/publisher_password.txt; viewing is anonymous by default. Media ports: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "Publishing requires the username 'publisher' and the random password stored in /var/lib/mediamtx/publisher_password.txt (readable by the NAS administrator); viewing is anonymous unless you change it. Edit /var/lib/mediamtx/mediamtx.yml to add authentication, recording, per-path settings or more users. 'apt remove' keeps /var/lib/mediamtx; 'apt purge' deletes configuration, recordings and the password file. Licensed MIT upstream."

[cs-cz]
name         = "Streamovací server MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX je samostatně hostovaný server pro streamování médií postavený na jediném binárním souboru Go bez závislostí. Umí současně RTSP, RTMP, HLS, WebRTC i SRT: kamery a kodéry publikují stream jednou a libovolný počet přehrávačů si jej stáhne zvoleným protokolem — ideální základ pro sledování IP kamer a živé vysílání na NAS. Vestavěná webová konzole se otevírá v nové kartě z plochy TOS: vypisuje aktivní cesty, odkazuje na přehrávač v prohlížeči a předává kompletní správní API. Správní API (9997), metriky (9998) a přehrávání (9996) naslouchají pouze na loopbacku a jsou dostupné výhradně přes webovou bránu TOS. Mediální porty zůstávají otevřené pro LAN, protože jsou hlavní funkcí: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) a SRT 8890. Služba běží jako vyhrazený neprivilegovaný uživatel v zesíleném sandboxu systemd."
release_note = "Sestaveno z oficiálního zdrojového kódu MediaMTX 1.21.1 pomocí veřejného, bitově reprodukovatelného postupu CI (statické sestavení Go, žádné přiložené běhové prostředí) a bez jakékoli online instalace. Konfigurace je v /var/lib/mediamtx/mediamtx.yml a načítá se za běhu. Při instalaci se vygeneruje náhodné heslo pro publikování a uloží se ke čtení pouze pro root do /var/lib/mediamtx/publisher_password.txt; sledování je ve výchozím stavu anonymní. Mediální porty: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "Pro publikování je třeba uživatelské jméno 'publisher' a náhodné heslo v /var/lib/mediamtx/publisher_password.txt (čitelné správcem NAS); sledování je ve výchozím stavu anonymní. Úpravou /var/lib/mediamtx/mediamtx.yml přidáte autentizaci, nahrávání, nastavení cest nebo další uživatele. 'apt remove' zachová /var/lib/mediamtx; 'apt purge' smaže konfiguraci, nahrávky a soubor s heslem. Licence upstream: MIT."

