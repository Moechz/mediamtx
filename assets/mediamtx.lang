[id-id]
name         = "Server Streaming MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX adalah server streaming media yang di-hosting sendiri, dibangun dari satu biner Go tanpa dependensi. Ia mendukung RTSP, RTMP, HLS, WebRTC, dan SRT sekaligus: kamera dan encoder cukup mempublikasikan satu aliran sekali, lalu berapa pun pemutar dapat menariknya dengan protokol pilihannya — basis ideal untuk pemantauan kamera IP dan siaran langsung di NAS. Konsol web bawaan terbuka di tab baru dari desktop TOS: menampilkan jalur aktif, menautkan pemutar browser, dan mem-proxy API manajemen secara lengkap. API manajemen (9997), metrik (9998), dan pemutaran ulang (9996) hanya mendengarkan di loopback dan hanya dapat diakses melalui gateway web TOS. Port media tetap terbuka untuk LAN karena itulah fungsi utamanya: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), dan SRT 8890. Layanan berjalan sebagai pengguna khusus tanpa hak istimewa di dalam sandbox systemd yang diperketat."
release_note = "Dibangun dari kode sumber resmi MediaMTX 1.21.1 dengan resep CI publik yang dapat direproduksi secara bit (build Go statis, tanpa runtime bawaan) dan tanpa instalasi online sama sekali. Konfigurasi berada di /var/lib/mediamtx/mediamtx.yml dan dimuat ulang secara panas. Kata sandi publikasi acak dibuat saat instalasi dan disimpan agar hanya dapat dibaca root di /var/lib/mediamtx/publisher_password.txt; penontonan anonim secara default. Port media: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "Untuk mempublikasikan diperlukan nama pengguna 'publisher' dan kata sandi acak di /var/lib/mediamtx/publisher_password.txt (dapat dibaca administrator NAS); penontonon anonim secara default. Edit /var/lib/mediamtx/mediamtx.yml untuk menambahkan autentikasi, perekaman, pengaturan per jalur, atau pengguna lain. 'apt remove' menyimpan /var/lib/mediamtx; 'apt purge' menghapus konfigurasi, rekaman, dan berkas kata sandi. Lisensi upstream MIT."

[nb-no]
name         = "MediaMTX Streaming Server"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX er en selvhostet mediestrømmingsserver bygget på én avhengighetsfri Go-binær. Den snakker RTSP, RTMP, HLS, WebRTC og SRT samtidig: kameraer og kodere publiserer en strøm én gang, og så mange avspillere som helst henter den med protokollen de foretrekker — ideell base for IP-kameraovervåking og direktesending på en NAS. En innebygd nettkonsoll åpnes i en ny fane fra TOS-skrivebordet: den viser aktive stier, lenker til nettleseravspilleren og videresender hele administrasjons-API-et. Administrasjons-API (9997), metrikker (9998) og avspilling (9996) lytter kun på loopback og nås utelukkende via TOS' nettgrensesnitt. Medieportene er åpne mot lokalnettet fordi de er kjernefunksjonen: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) og SRT 8890. Tjenesten kjører som en dedikert upriviligert bruker i en herdet systemd-sandkasse."
release_note = "Bygget fra den offisielle kildekoden til MediaMTX 1.21.1 med en offentlig, bit-reproduserbar CI-oppskrift (statisk Go-bygg, ingen medfølgende kjøretid) og ingen online installasjon. Konfigurasjonen ligger i /var/lib/mediamtx/mediamtx.yml og lastes på nytt ved endring. Et tilfeldig publiseringspassord genereres ved installasjon og lagres root-lesbart i /var/lib/mediamtx/publisher_password.txt; visning er anonym som standard. Medieporter: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "Publisering krever brukernavnet «publisher» og det tilfeldige passordet i /var/lib/mediamtx/publisher_password.txt (lesbart for NAS-administratoren); visning er anonym som standard. Rediger /var/lib/mediamtx/mediamtx.yml for å legge til autentisering, opptak, innstillinger per sti eller flere brukere. 'apt remove' beholder /var/lib/mediamtx; 'apt purge' sletter konfigurasjon, opptak og passordfilen. Oppstrømslisens: MIT."

[nl-nl]
name         = "MediaMTX-streamingserver"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX is een zelf-gehoste mediastreamingserver op basis van één afhankelijkheidsvrije Go-binary. Hij spreekt tegelijk RTSP, RTMP, HLS, WebRTC en SRT: camera's en encoders publiceren een stream één keer en willekeurig veel spelers halen die op met het protocol van hun keuze — de ideale basis voor IP-camerabewaking en live-uitzendingen op een NAS. Een ingebouwde webconsole opent in een nieuw browsertabblad vanaf het TOS-bureaublad: hij toont actieve paden, linkt naar de browserspeler en proxyt de volledige beheer-API. De beheer-API (9997), metrieken (9998) en weergave (9996) luisteren alleen op loopback en zijn uitsluitend bereikbaar via de TOS-webgateway. Mediapoorten blijven open voor LAN-clients omdat ze de kernfunctie zijn: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) en SRT 8890. De dienst draait als een speciale niet-geprivilegieerde gebruiker in een geharde systemd-sandbox."
release_note = "Gebouwd uit de officiële MediaMTX 1.21.1-broncode met een openbare, bit-reproduceerbare CI-recept (statische Go-build, geen meegeleverde runtime) en zonder enige online-installatie. De configuratie staat in /var/lib/mediamtx/mediamtx.yml en wordt direct herladen. Bij installatie wordt een willekeurig publicatiewachtwoord gegenereerd en root-leesbaar opgeslagen in /var/lib/mediamtx/publisher_password.txt; meekijken is standaard anoniem. Mediapoorten: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "Voor publiceren zijn de gebruikersnaam 'publisher' en het willekeurige wachtwoord in /var/lib/mediamtx/publisher_password.txt nodig (leesbaar voor de NAS-beheerder); meekijken is standaard anoniem. Bewerk /var/lib/mediamtx/mediamtx.yml om authenticatie, opnemen, instellingen per pad of meer gebruikers toe te voegen. 'apt remove' bewaart /var/lib/mediamtx; 'apt purge' verwijdert configuratie, opnamen en het wachtwoordbestand. Upstream-licentie: MIT."

[sv-se]
name         = "MediaMTX-strömningsserver"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX är en egenhostad medieströmningsserver byggd på en enda beroendefri Go-binär. Den talar RTSP, RTMP, HLS, WebRTC och SRT samtidigt: kameror och kodare publicerar en ström en gång och hur många spelare som helst hämtar den med sitt valda protokoll — den idealiska basen för IP-kameraövervakning och direktsändning på en NAS. En inbyggd webbkonsol öppnas i en ny flik från TOS-skrivbordet: den listar aktiva sökvägar, länkar till webbläsarspelaren och vidarebefordrar hela hanterings-API:et. Hanterings-API (9997), mätvärden (9998) och uppspelning (9996) lyssnar endast på loopback och nås uteslutande via TOS webbgateway. Mediaportarna är öppna mot LAN eftersom de är kärnfunktionen: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) och SRT 8890. Tjänsten körs som en dedikerad oprivilegierad användare i en härdad systemd-sandbox."
release_note = "Byggd från den officiella källkoden för MediaMTX 1.21.1 med ett offentligt, bitreproducerbart CI-recept (statisk Go-build, ingen medföljande körtid) och utan online-installation. Konfigurationen finns i /var/lib/mediamtx/mediamtx.yml och laddas om vid ändring. Ett slumpmässigt publiceringslösenord genereras vid installation och lagras root-läsbart i /var/lib/mediamtx/publisher_password.txt; tittande är anonymt som standard. Mediaportar: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "För att publicera krävs användarnamnet 'publisher' och det slumpmässiga lösenordet i /var/lib/mediamtx/publisher_password.txt (läsbart för NAS-administratören); tittande är anonymt som standard. Redigera /var/lib/mediamtx/mediamtx.yml för att lägga till autentisering, inspelning, inställningar per sökväg eller fler användare. 'apt remove' behåller /var/lib/mediamtx; 'apt purge' raderar konfiguration, inspelningar och lösenordsfilen. Uppströmslicens: MIT."

[th-th]
name         = "เซิร์ฟเวอร์สตรีมมิ่ง MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX เป็นเซิร์ฟเวอร์สตรีมมิ่งสื่อที่โฮสต์เอง สร้างจากไบนารี Go ไฟล์เดียวที่ไม่พึ่งพาไลบรารีภายนอก รองรับ RTSP, RTMP, HLS, WebRTC และ SRT พร้อมกัน กล้องและตัวเข้ารหัสอัปโหลดสตรีมเพียงครั้งเดียว แล้วผู้เล่นจำนวนเท่าใดก็ได้ดึงไปด้วยโปรโตคอลที่ต้องการ เหมาะเป็นฐานสำหรับระบบกล้องวงจรปิด IP และการถ่ายทอดสดบน NAS คอนโซลเว็บในตัวเปิดในแท็บใหม่จากเดสก์ท็อป TOS แสดงเส้นทางที่ใช้งานอยู่ ลิงก์ไปยังเครื่องเล่นในเบราว์เซอร์ และพร็อกซี API การจัดการทั้งหมด API การจัดการ (9997) เมตริก (9998) และการเล่นย้อนหลัง (9996) ฟังเฉพาะลูปแบ็กและเข้าถึงได้ผ่านเกตเวย์เว็บของ TOS เท่านั้น พอร์ตสื่อเปิดให้ LAN เพราะเป็นฟังก์ชันหลัก: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) และ SRT 8890 บริการทำงานเป็นผู้ใช้เฉพาะที่ไม่ใช่ root ภายในแซนด์บ็อกซ์ systemd ที่เสริมความปลอดภัย"
release_note = "สร้างจากซอร์สโค้ดอย่างเป็นทางการของ MediaMTX 1.21.1 ด้วยสูตร CI สาธารณะที่ทำซ้ำได้ในระดับบิต (บิลด์ Go แบบสแตติก ไม่มีรันไทม์มาด้วย) และไม่มีการติดตั้งออนไลน์ทุกขั้นตอน การตั้งค่าอยู่ที่ /var/lib/mediamtx/mediamtx.yml และโหลดใหม่ทันทีเมื่อแก้ไข รหัสผ่านสำหรับเผยแพร่จะถูกสุ่มตอนติดตั้งและเก็บให้ root อ่านได้ที่ /var/lib/mediamtx/publisher_password.txt การรับชมเป็นแบบไม่ระบุตัวตนโดยค่าเริ่มต้น พอร์ตสื่อ: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890"
important    = "การเผยแพร่ต้องใช้ชื่อผู้ใช้ publisher และรหัสผ่านสุ่มใน /var/lib/mediamtx/publisher_password.txt (ผู้ดูแล NAS อ่านได้) การรับชมเป็นแบบไม่ระบุตัวตนโดยค่าเริ่มต้น แก้ไข /var/lib/mediamtx/mediamtx.yml เพื่อเพิ่มการยืนยันตัวตน การบันทึก การตั้งค่าต่อเส้นทาง หรือผู้ใช้เพิ่มเติม apt remove จะเก็บ /var/lib/mediamtx ไว้ ส่วน apt purge จะลบการตั้งค่า ไฟล์บันทึก และไฟล์รหัสผ่าน สัญญาอนุญาต upstream คือ MIT"

[vi-vn]
name         = "Máy chủ truyền phát MediaMTX"
auth         = "@@AUTH@@"
version      = "@@VERSION@@"
descript     = "MediaMTX là máy chủ truyền phát đa phương tiện tự lưu trữ, được xây dựng từ một tệp nhị phân Go duy nhất không phụ thuộc. Nó hỗ trợ đồng thời RTSP, RTMP, HLS, WebRTC và SRT: camera và bộ mã hóa chỉ cần đẩy luồng một lần, và không giới hạn số trình phát kéo về bằng giao thức mình chọn — nền tảng lý tưởng cho giám sát camera IP và phát trực tiếp trên NAS. Bảng điều khiển web tích hợp mở trong tab mới từ màn hình TOS: liệt kê các đường dẫn đang hoạt động, liên kết tới trình phát trên trình duyệt và chuyển tiếp toàn bộ API quản trị. API quản trị (9997), số liệu (9998) và phát lại (9996) chỉ lắng nghe trên loopback và chỉ truy cập được qua cổng web của TOS. Các cổng media mở cho mạng LAN vì đó là chức năng chính: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189) và SRT 8890. Dịch vụ chạy dưới người dùng chuyên dụng không đặc quyền trong sandbox systemd được tăng cường."
release_note = "Được biên dịch từ mã nguồn chính thức MediaMTX 1.21.1 bằng công thức CI công khai, tái lập được đến từng bit (bản dựng Go tĩnh, không kèm runtime) và không cài đặt trực tuyến ở bất kỳ bước nào. Cấu hình nằm tại /var/lib/mediamtx/mediamtx.yml và tự động nạp lại khi sửa. Mật khẩu đẩy luồng ngẫu nhiên được tạo khi cài đặt và lưu để root đọc tại /var/lib/mediamtx/publisher_password.txt; việc xem mặc định là ẩn danh. Cổng media: RTSP 8554, RTMP 1935, HLS 8888, WebRTC 8889 (ICE/UDP 8189), SRT 8890."
important    = "Để đẩy luồng cần tên người dùng publisher và mật khẩu ngẫu nhiên trong /var/lib/mediamtx/publisher_password.txt (quản trị viên NAS đọc được); việc xem mặc định là ẩn danh. Sửa /var/lib/mediamtx/mediamtx.yml để thêm xác thực, ghi hình, thiết lập theo đường dẫn hoặc thêm người dùng. 'apt remove' giữ lại /var/lib/mediamtx; 'apt purge' xóa cấu hình, bản ghi và tệp mật khẩu. Giấy phép upstream: MIT."
